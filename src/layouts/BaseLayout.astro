---
import SeoHead from '../components/seo/SeoHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en" class="scheme-dark scroll-smooth scroll-pt-24 motion-reduce:scroll-auto">
  <head><SeoHead {...Astro.props} /></head>
  <body
    class="bg-page bg-[radial-gradient(ellipse_at_82%_8%,rgb(173_232_53/9.5%),transparent_31rem)] font-sans leading-[1.65] text-foreground antialiased selection:bg-accent selection:text-page [&_:focus-visible]:outline-3 [&_:focus-visible]:outline-accent-bright [&_:focus-visible]:outline-offset-4"
  >
    <a
      class="fixed top-4 left-4 z-100 -translate-y-[180%] bg-foreground px-[0.9rem] py-[0.65rem] font-[750] text-page focus:translate-y-0"
      href="#main-content"
    >Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
