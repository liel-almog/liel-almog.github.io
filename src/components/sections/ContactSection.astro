---
import ButtonLink from '../ui/ButtonLink.astro';
import { site } from '../../data/site';

const linkedIn = site.profiles.find((profile) => profile.name === 'LinkedIn');
---

<section class="border-t border-line py-[clamp(4rem,8vw,7rem)]" id="contact" aria-labelledby="contact-title">
  <div class="mx-auto w-[calc(100%-2.5rem)] max-w-site">
    <p class="mb-5 text-[0.7rem] font-[750] tracking-[0.08em] text-accent uppercase">Contact</p>
    <h2 id="contact-title" class="font-display mb-5 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] font-bold tracking-[-0.055em]">
      Let’s connect<span class="text-accent">.</span>
    </h2>
    <p class="mb-8 max-w-[35rem] text-[1.05rem] text-muted">
      Have a project, an idea, or just want to say hello? Email me or connect on LinkedIn.
    </p>
    <div class="flex flex-wrap gap-3">
      <ButtonLink href={`mailto:${site.email}`} variant="primary" arrow="↗">{site.email}</ButtonLink>
      {linkedIn && (
        <ButtonLink href={linkedIn.href} arrow="↗">Connect on LinkedIn</ButtonLink>
      )}
    </div>
  </div>
</section>
