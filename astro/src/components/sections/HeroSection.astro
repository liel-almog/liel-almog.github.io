---
import { hero } from '../../data/home';
import ButtonLink from '../ui/ButtonLink.astro';
import SystemMap from '../illustrations/SystemMap.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.heading} <span>{hero.emphasis}</span></h1>
      <p class="lead">{hero.description}</p>
      <div class="actions">
        {hero.actions.map((action) => <ButtonLink href={action.href} variant={action.variant} arrow={action.arrow}>{action.label}</ButtonLink>)}
      </div>
      <ul aria-label="Core capabilities">
        {hero.capabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </div>
    <SystemMap />
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: min(52rem, calc(100svh - 5.35rem));
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 1.4rem 0 1.5rem;
    font-size: clamp(3.2rem, 8vw, 7.2rem);
    font-weight: 820;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  h1 span {
    color: var(--accent);
  }

  .lead {
    max-width: 39rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.75rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.75rem;
  }

  li::before {
    content: '↗';
    margin-right: 0.4rem;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    h1 {
      max-width: 14ch;
    }

  }

  @media (max-width: 380px) {
    h1 {
      font-size: 2.8rem;
    }

  }
</style>
