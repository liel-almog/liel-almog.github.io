---
import { expertiseSection, skillGroups } from '../../data/expertise';
import SkillGroup from '../expertise/SkillGroup.astro';
---

<section class="border-t border-line bg-surface/45 py-[clamp(4rem,8vw,7rem)]" id="expertise" aria-labelledby="expertise-title">
  <div class="mx-auto w-[calc(100%-2.5rem)] max-w-site">
    <div class="mb-10 grid grid-cols-2 items-end gap-10 mobile:grid-cols-1 mobile:gap-6">
      <div>
        <p class="mb-5 flex items-center gap-3 text-[0.7rem] font-[750] tracking-[0.08em] text-accent uppercase">
          <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
          {expertiseSection.eyebrow}
        </p>
        <h2 class="text-[clamp(2.5rem,4.5vw,4.5rem)] leading-[1.05] font-bold tracking-[-0.055em]" id="expertise-title">
          {expertiseSection.heading}
          <span class="block text-accent">{expertiseSection.emphasis}</span>
        </h2>
      </div>
      <p class="max-w-xl text-sm leading-7 text-muted">{expertiseSection.description}</p>
    </div>
    <div class="grid grid-cols-1 border-t border-l border-line min-[600px]:grid-cols-2 min-[901px]:grid-cols-6">
      {skillGroups.map((group, index) => <SkillGroup group={group} wide={index >= 3} />)}
    </div>
  </div>
</section>
