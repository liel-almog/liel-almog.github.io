---
const nodes = [
  { x: 52, radius: 30, title: '01', label: 'NEED' },
  { x: 218, radius: 43, title: 'CORE', label: 'DESIGN + BUILD' },
  { x: 356, radius: 30, title: 'SHIP', label: 'CLOUD' },
  { x: 508, radius: 30, title: 'RUN', label: 'OPERATE' },
];
const track = 'M82 190H175M261 190H326M386 190H478M218 147V80H358V160M356 220V305H218V233';
---

<aside aria-labelledby="system-map-title">
  <div class="heading"><p>How I work</p><span>Built for production</span></div>
  <h2 id="system-map-title">From first constraint to <span>running system.</span></h2>
  <svg viewBox="0 0 560 390" role="img" aria-labelledby="map-title map-description">
    <title id="map-title">A system built from connected parts</title>
    <desc id="map-description">Product needs flow through design and services into cloud delivery, data, and continuous operation.</desc>
    <path class="track" d={track} />
    <path class="flow" d={track} />
    {nodes.map((node) => (
      <g class:list={['node', { core: node.title === 'CORE' }]}>
        <circle cx={node.x} cy="190" r={node.radius} />
        <text x={node.x} y="194">{node.title}</text>
        <text class="label" x={node.x} y={node.title === 'CORE' ? 255 : 242}>{node.label}</text>
      </g>
    ))}
    <g class="satellite"><circle cx="358" cy="80" r="23" /><text x="358" y="84">DATA</text></g>
    <g class="satellite"><circle cx="218" cy="305" r="23" /><text x="218" y="309">APIs</text></g>
  </svg>
  <p class="caption">Architecture <span>→</span> delivery <span>→</span> operation</p>
</aside>

<style>
  aside {
    min-width: 0;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    border: 1px solid var(--border);
    background: linear-gradient(rgb(199 255 62 / 3.5%) 1px, transparent 1px), linear-gradient(90deg, rgb(199 255 62 / 3.5%) 1px, transparent 1px), var(--surface);
    background-size: 28px 28px;
    box-shadow: 0 32px 90px rgb(0 0 0 / 30%);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.65rem;
  }

  .heading p {
    margin: 0;
    color: var(--accent);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .heading > span {
    color: var(--muted);
  }

  h2 {
    max-width: 16ch;
    margin: 1rem 0 0;
    font-size: clamp(1.55rem, 2.5vw, 2.3rem);
  }

  h2 span, .caption span {
    color: var(--accent);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .track, .flow {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .track {
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .flow {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 7 14;
    animation: flow 2.6s linear infinite;
  }

  circle {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .core circle {
    fill: #2a3916;
    stroke: var(--accent);
    stroke-width: 2;
  }

  text {
    fill: var(--accent-bright);
    font: 700 11px ui-monospace, monospace;
    text-anchor: middle;
  }

  .label {
    fill: var(--muted);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .satellite text {
    font-size: 9px;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
    font: 650 0.65rem ui-monospace, monospace;
    text-transform: uppercase;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -42;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .flow {
      animation: none;
    }

  }
</style>
