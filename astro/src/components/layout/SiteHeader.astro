---
import { legacySection, navigation, site } from '../../data/site';

const linkClasses = 'inline-flex min-h-11 items-center gap-[0.4rem] text-[0.7rem] font-[750] tracking-[0.08em] uppercase';
const socialIcons = {
  GitHub: 'M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18A11 11 0 0 1 12 6.13c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.82 1.19 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.28c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z',
  LinkedIn: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.04H3.54V8.98H7.1v11.47Z',
} as const;
---

<header class="sticky top-0 z-20 border-b border-line bg-page/94 backdrop-blur-[18px]" data-site-header>
  <div class="mx-auto flex min-h-[5.35rem] w-[calc(100%-2.5rem)] max-w-site items-center justify-between gap-8 max-[900px]:flex-wrap max-[900px]:gap-3 max-[900px]:py-4">
    <a class="grid shrink-0 leading-[1.3]" href="#top" aria-label={`${site.name}, home`}>
      <strong class="text-[0.95rem] font-bold">{site.name}</strong>
      <small class="text-[0.6rem] tracking-[0.12em] text-subtle uppercase">Software engineer</small>
    </a>
    <div class="ml-auto hidden items-center gap-1 max-[900px]:flex">
      <div class="flex items-center gap-1" aria-label="Social profiles">
        {site.profiles.map((profile) => (
          <a
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm text-subtle transition-colors hover:bg-surface-light hover:text-accent-bright"
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${profile.name} profile (opens in a new tab)`}
            title={profile.name}
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d={socialIcons[profile.name]} />
            </svg>
          </a>
        ))}
      </div>
      <button
        class="group hidden min-h-11 min-w-11 touch-manipulation cursor-pointer items-center justify-center rounded-sm border border-line-strong bg-surface text-foreground max-[900px]:inline-flex"
        data-menu-toggle
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label="Open navigation menu"
        title="Open navigation menu"
        hidden
      >
        <svg class="h-5 w-5 group-aria-expanded:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5 group-aria-expanded:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <nav
      class="flex items-center gap-[clamp(0.8rem,1.5vw,1.5rem)] max-[900px]:absolute max-[900px]:top-full max-[900px]:left-1/2 max-[900px]:w-[min(calc(100%-2.5rem),var(--container-site))] max-[900px]:-translate-x-1/2 max-[900px]:flex-col max-[900px]:items-stretch max-[900px]:gap-1 max-[900px]:rounded-sm max-[900px]:border max-[900px]:border-line max-[900px]:bg-surface max-[900px]:px-0 max-[900px]:pt-[0.65rem] max-[900px]:pb-2 max-[900px]:shadow-panel max-[900px]:data-collapsed:hidden max-[900px]:[&>a]:justify-start max-[900px]:[&>a]:px-[0.8rem]"
      id="primary-navigation"
      aria-label="Primary navigation"
    >
      {navigation.map((item) => (
        <a class:list={[linkClasses, 'text-muted hover:text-accent-bright']} href={item.href}>{item.label}</a>
      ))}
      <div
        class="flex items-center gap-1 border-l border-line pl-[clamp(0.6rem,1.2vw,1rem)] max-[900px]:hidden"
        aria-label="Social profiles"
      >
        {site.profiles.map((profile) => (
          <a
            class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-sm border border-transparent px-2 text-subtle transition-colors hover:border-line hover:bg-surface-light hover:text-accent-bright"
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${profile.name} profile (opens in a new tab)`}
            title={profile.name}
          >
            <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d={socialIcons[profile.name]} />
            </svg>
          </a>
        ))}
      </div>
      <a
        class:list={[linkClasses, 'rounded-sm border border-line-strong px-[0.8rem] py-2 text-muted hover:text-accent-bright']}
        href={site.resume}
      >Resume <span aria-hidden="true">↗</span></a>
      <a
        class:list={[linkClasses, 'rounded-sm border border-line-strong bg-accent px-[0.8rem] py-2 text-page hover:bg-accent-bright']}
        href={legacySection('contact')}
      >Let’s talk <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  import { setupNavigation } from '../../scripts/navigation';
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach(setupNavigation);
</script>
