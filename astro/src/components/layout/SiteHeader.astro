---
import { legacySection, navigation, site } from '../../data/site';

const linkClasses = 'inline-flex min-h-11 items-center gap-[0.4rem] text-[0.7rem] font-[750] tracking-[0.08em] uppercase';
---

<header class="sticky top-0 z-20 border-b border-line bg-page/94 backdrop-blur-[18px]" data-site-header>
  <div class="mx-auto flex min-h-[5.35rem] w-[calc(100%-2.5rem)] max-w-site items-center justify-between gap-8 mobile:flex-wrap mobile:gap-3 mobile:py-4">
    <a class="grid shrink-0 leading-[1.3]" href="#top" aria-label={`${site.name}, home`}>
      <strong class="text-[0.95rem] font-bold">{site.name}</strong>
      <small class="text-[0.6rem] tracking-[0.12em] text-subtle uppercase">Software engineer</small>
    </a>
    <button
      class="hidden min-h-11 cursor-pointer items-center gap-[0.65rem] rounded-sm border border-line-strong bg-surface px-3 py-2 text-foreground mobile:inline-flex"
      data-menu-toggle
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      hidden
    >Menu <span aria-hidden="true">☰</span></button>
    <nav
      class="flex items-center gap-[clamp(0.8rem,1.5vw,1.5rem)] mobile:w-full mobile:flex-wrap mobile:data-enhanced:flex-col mobile:data-enhanced:items-stretch mobile:data-enhanced:pb-2 mobile:data-collapsed:hidden"
      id="primary-navigation"
      aria-label="Primary navigation"
    >
      {navigation.map((item) => (
        <a class:list={[linkClasses, 'text-muted hover:text-accent-bright']} href={item.href}>{item.label}</a>
      ))}
      <a
        class:list={[linkClasses, 'rounded-sm border border-line-strong px-[0.8rem] py-2 text-muted hover:text-accent-bright']}
        href={site.resume}
      >Resume <span aria-hidden="true">↗</span></a>
      <a
        class:list={[linkClasses, 'rounded-sm border border-line-strong bg-accent px-[0.8rem] py-2 text-page hover:bg-accent-bright']}
        href={legacySection('contact')}
      >Let’s talk <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  import { setupNavigation } from '../../scripts/navigation';
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach(setupNavigation);
</script>
