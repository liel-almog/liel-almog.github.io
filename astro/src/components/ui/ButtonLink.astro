---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  arrow?: string;
}

const { href, variant = 'secondary', arrow } = Astro.props;
---

<a class:list={['button', variant]} href={href}>
  <slot />
  {arrow && <span aria-hidden="true">{arrow}</span>}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.25rem;
    font-size: 0.85rem;
    font-weight: 750;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }

  .primary:hover {
    background: var(--accent-bright);
    box-shadow: 0 0 0 5px rgb(199 255 62 / 12%);
  }

  .secondary:hover {
    background: var(--surface-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

  }
</style>
