---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  arrow?: string;
}

const { href, variant = 'secondary', arrow } = Astro.props;
const variants = {
  primary: 'bg-accent text-page hover:bg-accent-bright hover:shadow-[0_0_0_5px_rgb(199_255_62/12%)]',
  secondary: 'hover:bg-surface-light',
};
---

<a
  class:list={[
    'inline-flex min-h-11 items-center justify-center gap-3 rounded-sm border border-line-strong px-4 py-[0.7rem] text-[0.85rem] font-[750] transition-[background-color,box-shadow] duration-160 ease-in-out motion-reduce:transition-none',
    variants[variant],
  ]}
  href={href}
>
  <slot />
  {arrow && <span aria-hidden="true">{arrow}</span>}
</a>
