---
import { projects } from '../../data/projects';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
---

<div class="overflow-hidden rounded-xl border border-line bg-surface/45 shadow-panel" data-project-tabs>
  <div class="grid grid-cols-3 border-b border-line mobile:grid-cols-1" data-project-tablist aria-label="Select a project" hidden>
    {projects.map((project, index) => (
      <button
        class="flex min-h-16 cursor-pointer items-center gap-3 border-b-2 border-transparent px-6 py-4 text-left text-sm font-bold text-muted hover:bg-surface-light hover:text-foreground aria-selected:border-accent aria-selected:bg-accent/8 aria-selected:text-accent mobile:min-h-14 mobile:px-5"
        type="button"
        id={`project-tab-${project.id}`}
        data-project-tab
        aria-controls={`project-panel-${project.id}`}
      >
        <span class="font-mono text-xs opacity-60" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        {project.name}
      </button>
    ))}
  </div>

  {projects.map((project) => (
    <article class="p-8 mobile:p-5" id={`project-panel-${project.id}`} data-project-panel aria-labelledby={`project-title-${project.id}`}>
      <div class="grid grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] gap-8 mobile:grid-cols-1 mobile:gap-5">
        <div>
          <p class="mb-3 font-mono text-xs leading-6 text-accent">{project.category}</p>
          <h3 class="text-[clamp(1.7rem,3vw,2.5rem)] leading-tight font-bold tracking-[-0.04em]" id={`project-title-${project.id}`}>{project.name}</h3>
          <p class="mt-4 text-sm leading-7 text-muted">{project.summary}</p>
          <a class="mt-5 inline-flex min-h-11 items-center gap-3 text-sm font-bold text-accent hover:text-accent-bright" href={project.href}>
            {project.linkLabel} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="border-l border-line pl-8 mobile:border-t mobile:border-l-0 mobile:pt-5 mobile:pl-0">
          <p class="mb-3 font-mono text-[0.65rem] tracking-[0.15em] text-subtle uppercase">What drew me in</p>
          <p class="text-sm leading-7 text-muted">{project.motivation}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${project.name} technologies`}>
            {project.technologies.map((technology) => (
              <li class:list={[
                'rounded-md border px-2.5 py-1 text-xs leading-5',
                technology === 'Go' ? 'border-accent/40 bg-accent/10 font-bold text-accent' : 'border-line bg-page/55 text-muted',
              ]}>{technology}</li>
            ))}
          </ul>
        </div>
      </div>
      <ArchitectureDiagram project={project} />
    </article>
  ))}
</div>

<script>
  import { setupProjectTabs } from '../../scripts/project-tabs';
  document.querySelectorAll<HTMLElement>('[data-project-tabs]').forEach(setupProjectTabs);
</script>
